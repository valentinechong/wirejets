{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "sniff": "php vendor/bin/phpcs --report-full -s -p -n --report-summary --runtime-set ignore_warnings_on_exit true",
        "fix": "php vendor/bin/phpcbf --report-full -s -n --report-summary",
        "analyse": "php vendor/bin/phpstan analyse"
    },
    "devDependencies": {
        "@tailwindcss/forms": "^0.5.7",
        "@tailwindcss/typography": "^0.5.10",
        "@tailwindcss/vite": "^4.0.0",
        "autoprefixer": "^10.4.16",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^2.0.0",
        "postcss": "^8.4.32",
        "tailwindcss": "^3.4.0",
        "vite": "^7.0.7"
    }
}
